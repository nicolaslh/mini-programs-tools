{
  "name": "mini-programs-tools",
  "version": "0.1.0",
  "private": true,
  "description": "A modular utility collection built with uni-app, Vue 3 and TypeScript.",
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "tools:generate": "node scripts/generate-tools.mjs",
    "dev:app": "pnpm tools:generate && uni -p app",
    "dev:h5": "pnpm tools:generate && uni",
    "dev:mp-weixin": "pnpm tools:generate && uni -p mp-weixin",
    "dev:mp-alipay": "pnpm tools:generate && uni -p mp-alipay",
    "dev:mp-toutiao": "pnpm tools:generate && uni -p mp-toutiao",
    "build:app": "pnpm tools:generate && uni build -p app",
    "build:h5": "pnpm tools:generate && uni build",
    "build:mp-weixin": "pnpm tools:generate && uni build -p mp-weixin",
    "build:mp-alipay": "pnpm tools:generate && uni build -p mp-alipay",
    "build:mp-toutiao": "pnpm tools:generate && uni build -p mp-toutiao",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-mp-alipay": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-mp-toutiao": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030220261016001",
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "vue-i18n": "9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5030220261016001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030220261016001",
    "@vue/tsconfig": "0.5.1",
    "typescript": "5.4.5",
    "vite": "5.2.8",
    "vitest": "1.6.1",
    "vue-tsc": "2.0.29"
  }
}
